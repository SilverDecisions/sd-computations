{
  "name": "sd-computations",
  "version": "0.6.1",
  "description": "SilverDecisions computations module",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && rollup -c",
    "test": "node scripts/prepare-test.js && karma start karma.conf.js --single-run --browsers ChromeHeadlessCI",
    "test:build": "node scripts/check-build.js",
    "docs": "documentation build src/computations-manager.js -f md --shallow -o doc/API.md",
    "release": "release-it --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverDecisions/sd-computations.git"
  },
  "keywords": [
    "SilverDecisions",
    "computations"
  ],
  "author": "Michał Wasiluk, Bogumił Kamiński",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/SilverDecisions/sd-computations/issues"
  },
  "homepage": "https://github.com/SilverDecisions/sd-computations#readme",
  "browserslist": [
    "last 3 versions",
    "> 0.25%",
    "Firefox ESR",
    "not dead"
  ],
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "global": true,
          "ignore": [
            "/\\/node_modules\\/(?!idb\\/)/"
          ],
          "presets": [
            "@babel/preset-env"
          ],
          "plugins": [
            "transform-class-properties",
            "transform-object-assign",
            [
              "transform-builtin-extend",
              {
                "globals": [
                  "Error"
                ]
              }
            ]
          ]
        }
      ]
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/preset-env": "^7.15.6",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "acorn": "^8.19.0",
    "babel-plugin-istanbul": "^6.0.0",
    "babel-plugin-transform-builtin-extend": "^1.1.2",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-plugin-transform-object-assign": "^6.22.0",
    "babelify": "10.0.0",
    "browserify": "^17.0.0",
    "csv": "^5.5.3",
    "documentation": "^13.2.5",
    "jasmine": "^3.9.0",
    "jasmine-jquery": "^2.1.1",
    "jquery": "^3.6.0",
    "karma": "^6.3.4",
    "karma-browserify": "^8.1.0",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage": "^2.0.3",
    "karma-firefox-launcher": "^2.1.1",
    "karma-jasmine": "^4.0.1",
    "release-it": "^14.11.6",
    "rollup": "^4.67.5",
    "watchify": "^4.0.0"
  },
  "dependencies": {
    "idb": "^6.1.4",
    "sd-expression-engine": "~0.1.17",
    "sd-model": "~0.2.11",
    "sd-random": "^0.1.4",
    "sd-utils": "^0.1.15"
  }
}
